{
  "manifest_version": 3,
  "name": "img2img",
  "version": "1.0.5",
  "key": "",
  "description": "Edit images on any web page: remove or replace backgrounds, upscale, restore old photos and make reference maps.",
  "homepage_url": "https://img2img.shop",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8188/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/workflows.js", "shared/custom-workflows.js", "content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
} 